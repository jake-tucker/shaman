{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "ShamanUI",
    },
  ],
  "files": [
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Shaman.app", "id": "23B7CBC730AD550A0048783A", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ShamanUITests.xctest", "id": "2328A11B30AD551000605EF1", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/ShamanTests.xctest", "id": "237024F930AD64BA008CF7C7", "type": "wrapper.cfbundle", "index": false },
      ],
    },
    { "kind": "folder", "path": "Shaman", "target-membership": [ "Shaman" ] },
    { "kind": "folder", "path": "ShamanUITests", "target-membership": [ "ShamanUITests" ] },
    { "kind": "folder", "path": "ShamanTests", "target-membership": [ "ShamanTests" ] },
  ],
  "targets": [
    {
      "name": "Shaman",
      "id": "23B7CBC630AD550A0048783A",
      "product": "Products/Shaman.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "ShamanUI",
          "product-name": "ShamanUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Shaman",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Shaman scans the code a server shows to pair this phone with it.",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Shaman reaches the servers you pair this phone with on your network.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.jaketucker.shaman",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    }, {
      "name": "ShamanUITests",
      "id": "2328A11A30AD551000605EF1",
      "product": "Products/ShamanUITests.xctest",
      "product-type": "bundle.ui-testing",
      "dependencies": [
        "Shaman",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.jaketucker.shaman.uitests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_TARGET_NAME": "Shaman",
      },
    }, {
      "name": "ShamanTests",
      "id": "237024F830AD64BA008CF7C7",
      "product": "Products/ShamanTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "Shaman",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.jaketucker.shaman.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Shaman.app/Shaman",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "arm64",
    "CODE_SIGN_STYLE": "Automatic",
    "CURRENT_PROJECT_VERSION": "1",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "645L89QC7B",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_TREAT_WARNINGS_AS_ERRORS": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "MARKETING_VERSION": "0.1.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
    "SUPPORTS_MACCATALYST": "NO",
    "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
    "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_EMIT_LOC_STRINGS": "NO",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
    "SWIFT_VERSION": "6.0",
    "TARGETED_DEVICE_FAMILY": "1",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
}
